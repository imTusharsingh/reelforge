{
  "name": "reelforge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.22.2",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:secrets": "node scripts/check-secrets.mjs",
    "db:generate": "pnpm --filter @reelforge/database db:generate",
    "db:validate": "pnpm --filter @reelforge/database db:validate",
    "db:check-migrations": "node scripts/check-migrations.mjs",
    "db:migrate:dev": "pnpm --filter @reelforge/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @reelforge/database db:migrate:deploy",
    "prepare": "husky || true",
    "test:e2e": "node scripts/run-e2e.mjs",
    "knip": "node scripts/check-knip.mjs",
    "knip:baseline": "node scripts/check-knip.mjs --write-baseline",
    "test:coverage:changed": "node scripts/check-changed-coverage.mjs",
    "lint:size": "eslint . --max-warnings=0",
    "quality": "pnpm lint && pnpm typecheck && pnpm knip"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "jsdom": "27.3.0",
    "knip": "6.22.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
