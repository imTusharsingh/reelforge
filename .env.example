# Local development only. Export this value for app commands. Never commit real secrets.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/reelforge?schema=public
# PostgreSQL or a session-mode endpoint if DATABASE_URL uses transaction pooling.
DIRECT_DATABASE_URL=
# Comma-separated IPs or CIDRs of reverse proxies allowed to supply client addresses.
API_TRUSTED_PROXIES=

# M04 asset storage. "local" is the only implemented driver and performs real
# filesystem writes. Selecting "s3" fails clearly until an approved adapter exists.
STORAGE_DRIVER=local
# Absolute local storage root; defaults to <os tmpdir>/reelforge-storage.
# STORAGE_LOCAL_ROOT=/var/lib/reelforge/assets
# Maximum asset upload size in bytes (default 25 MiB).
# ASSET_MAX_BYTES=26214400

# Optional browser origin for social OAuth return (for example http://localhost:3000).
WEB_APP_ORIGIN=

# YouTube OAuth redirect URI must match the URI registered with Google.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/social-accounts/oauth/youtube/callback
# 32 bytes encoded as base64url for stored social account tokens.
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Complete scheduled posts locally without uploading to YouTube by default.
PUBLISH_DRY_RUN=true
# 32 bytes encoded as base64url for live resumable upload sessions.
PUBLISH_SESSION_ENCRYPTION_KEY=

# Gemini primary and xAI fallback. Empty keys; model ids are configuration.
GEMINI_API_KEY=
XAI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-omni-1.2-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_MUSIC_MODEL=lyria-3.5
XAI_VIDEO_MODEL=grok-imagine-video-1.5
# 32 bytes encoded as base64url. Required for write-only workspace key storage.
PROVIDER_KEY_ENCRYPTION_KEY=
# Explicit current OpenAI text fallback model must be supplied when enabled.
OPENAI_API_KEY=
OPENAI_TEXT_FALLBACK_ENABLED=false
OPENAI_TEXT_MODEL=
# Legacy rollout flag. The current VideoRun path does not read it.
PIPELINE_V2=false

# Next server-side API proxy destination (not a browser public variable).
REELFORGE_API_ORIGIN=http://localhost:3001

# Optional HTTPS relay for password reset and email verification. Leave unset in CI.
ACCOUNT_EMAIL_RELAY_URL=
ACCOUNT_EMAIL_RELAY_TOKEN=
