# Local development only. Export this value for app commands. Never commit real secrets.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/reelforge?schema=public

# M04 asset storage. "local" is the only implemented driver and performs real
# filesystem writes. Selecting "s3" fails clearly until an approved adapter exists.
STORAGE_DRIVER=local
# Absolute local storage root; defaults to <os tmpdir>/reelforge-storage.
# STORAGE_LOCAL_ROOT=/var/lib/reelforge/assets
# Maximum asset upload size in bytes (default 25 MiB).
# ASSET_MAX_BYTES=26214400

# Optional browser origin for social OAuth return (for example http://localhost:3000).
WEB_APP_ORIGIN=

# Optional OpenAI provider bindings. When OPENAI_API_KEY is empty, all existing
# NotConfigured* providers remain active. Model names are explicit and never
# silently switched at runtime.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VIDEO_MODEL=sora-2

# Next server-side API proxy destination (not a browser public variable).
REELFORGE_API_ORIGIN=http://localhost:3001
