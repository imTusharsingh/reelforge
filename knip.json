{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "e2e/**/*.ts", "*.config.{ts,js,mjs}"],
      "project": ["scripts/*.mjs", "e2e/**/*.ts", "*.config.{ts,js,mjs}"]
    },
    "apps/api": { "entry": ["src/main.ts", "src/**/*.test.ts"], "project": ["src/**/*.ts"] },
    "apps/worker": { "entry": ["src/main.ts", "src/**/*.test.ts"], "project": ["src/**/*.ts"] },
    "apps/web": {
      "entry": [
        "app/**/{page,layout,route}.{ts,tsx}",
        "features/**/verification/*.{mjs,tsx,ts}",
        "**/*.test.ts",
        "next.config.ts"
      ],
      "project": ["**/*.{ts,tsx,mjs}"]
    },
    "packages/database": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "prisma.config.ts"],
      "project": ["src/**/*.ts", "prisma.config.ts"],
      "ignoreDependencies": ["@prisma/client"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "prisma.config.ts"],
      "project": ["src/**/*.ts", "prisma.config.ts"]
    }
  },
  "ignore": ["**/dist/**", "**/.next/**", "packages/database/src/generated/**", "work/**"],
  "ignoreDependencies": ["@vitest/coverage-v8"]
}
