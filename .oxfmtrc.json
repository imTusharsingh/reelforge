{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".next",
    "pnpm-lock.yaml",
    "packages/database/src/generated",
    "docs/",
    "prompts/",
    "templates/",
    "work-packages/"
  ]
}
