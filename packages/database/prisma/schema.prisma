generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PREFLIGHT
  UPLOADING
  REMOTE_PROCESSING
  PUBLISHED
  FAILED_RETRYABLE
  FAILED_FINAL
  CANCELED
  RECONCILIATION_REQUIRED
}

enum PublishingDisclosureDecision {
  DISCLOSE
  NOT_REQUIRED
}

enum PublishAttemptStatus {
  STARTED
  UPLOADING
  REMOTE_PROCESSING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_FINAL
  RECONCILIATION_REQUIRED
}

enum WorkflowState {
  CREATED
  QUEUED
  RUNNING
  WAITING_APPROVAL
  SUCCEEDED
  PAUSED
  RETRY_WAIT
  FAILED
  CANCELED
}

enum ChannelStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AssetOwnership {
  USER_UPLOADED
  STARTER_LIBRARY
  SYSTEM_GENERATED
}

enum AssetStatus {
  PENDING
  PUBLISHED
  FAILED
  ARCHIVED
}

enum CharacterStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CharacterVersionStatus {
  DRAFT
  PUBLISHED
}

enum PromptTemplateVersionStatus {
  DRAFT
  PUBLISHED
}

enum IdeaStatus {
  DRAFT
  BACKLOG
  APPROVED
  REJECTED
  SCHEDULED
}

enum IdeaOrigin {
  USER
  AI
}

enum SocialPlatform {
  YOUTUBE
  INSTAGRAM
}

enum SocialAccountStatus {
  CONNECTED
  REAUTH_REQUIRED
  REVOCATION_PENDING
  REVOCATION_FAILED
  REVOKED
}

enum SocialAccountHealth {
  HEALTHY
  AUTH_REQUIRED
  UNAVAILABLE
}

enum SocialPermissionStatus {
  GRANTED
  NOT_GRANTED
}

enum AnalyticsGranularity {
  CHANNEL
  VIDEO
}

enum MetricCompleteness {
  COMPLETE
  PARTIAL
  UNAVAILABLE
}

enum MetricAvailability {
  AVAILABLE
  UNAVAILABLE
}

enum MetricCollectionJobStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED_FINAL
}

enum MetricCollectionRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id                       String                @id @default(uuid()) @db.Uuid
  email                    String                @unique
  displayName              String?               @map("display_name")
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships              WorkspaceMembership[]
  credential               PasswordCredential?
  sessions                 Session[]
  authEvents               AuthEvent[]
  createdIdeas             Idea[]                @relation("IdeaCreator")
  createdSceneMediaJobs    SceneMediaJob[]
  createdRenderJobs        RenderJob[]
  createdQualityReviewRuns QualityReviewRun[]
  qualityDecisions         QualityDecision[]
  socialOAuthStates        SocialOAuthState[]
  scheduledPosts           ScheduledPost[]      @relation("ScheduledPostCreator")
  authorizedPosts          ScheduledPost[]      @relation("ScheduledPostPublisher")
  defaultWorkspaceId       String?               @map("default_workspace_id") @db.Uuid
  defaultWorkspace         Workspace?            @relation("UserDefaultWorkspace", fields: [defaultWorkspaceId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Workspace {
  id                          String                       @id @default(uuid()) @db.Uuid
  name                        String
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt                  DateTime?                    @map("archived_at") @db.Timestamptz(6)
  memberships                 WorkspaceMembership[]
  channels                    Channel[]
  genres                      Genre[]
  assets                      Asset[]
  characters                  Character[]
  characterVersions           CharacterVersion[]
  characterGroups             CharacterGroup[]
  characterGroupMembers       CharacterGroupMember[]
  characterGroupAssignments   CharacterGroupAssignment[]
  assetUsageReferences        AssetUsageReference[]
  workflowRuns                WorkflowRun[]
  outboxEvents                OutboxEvent[]
  defaultForUsers             User[]                       @relation("UserDefaultWorkspace")
  activeConfigSnapshotId      String?                      @map("active_config_snapshot_id") @db.Uuid
  configSnapshots             WorkspaceConfigSnapshot[]
  generationConfigSnapshots   ConfigSnapshot[]
  promptTemplates             PromptTemplate[]
  promptTemplateVersions      PromptTemplateVersion[]
  promptBundleSnapshots       PromptBundleSnapshot[]
  ideas                       Idea[]
  ideaDuplicates              IdeaDuplicate[]
  ideaApprovalSnapshots       IdeaApprovalSnapshot[]
  scripts                     Script[]
  providerRequests            ProviderRequest[]
  providerBudgets             ProviderBudget[]
  providerBudgetReservations  ProviderBudgetReservation[]
  sceneMediaJobs              SceneMediaJob[]
  sceneGenerations            SceneGeneration[]
  sceneGenerationOutputs      SceneGenerationOutput[]
  renderJobs                  RenderJob[]
  renderArtifacts             RenderArtifact[]
  qualityReviewRuns           QualityReviewRun[]
  qualityDecisions            QualityDecision[]
  qualityRegenerationRequests QualityRegenerationRequest[]
  socialAccounts              SocialAccount[]
  socialOAuthStates           SocialOAuthState[]
  scheduledPosts              ScheduledPost[]
  publishingDestinations      PublishingDestination[]
  publishJobs                 PublishJob[]
  publishAttempts             PublishAttempt[]
  metricCollectionJobs        MetricCollectionJob[]
  metricCollectionRuns        MetricCollectionRun[]
  metricSnapshots             AnalyticsMetricSnapshot[]
  performanceInsightReports   PerformanceInsightReport[]
  performanceRecommendations  PerformanceRecommendation[]
  performanceExperiments      PerformanceExperiment[]
  performanceStrategyChanges  PerformanceStrategyChange[]
  activeConfigSnapshot        WorkspaceConfigSnapshot?     @relation("WorkspaceActiveConfigSnapshot", fields: [activeConfigSnapshotId], references: [id])

  @@unique([activeConfigSnapshotId])
  @@map("workspaces")
}

model PasswordCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("sessions")
}

model AuthEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  eventType  String   @map("event_type")
  outcome    String
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@map("auth_events")
}

model WorkspaceMembership {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  metricJobs  MetricCollectionJob[] @relation("MetricJobRequester")

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_memberships")
}

model Channel {
  id                        String                     @id @default(uuid()) @db.Uuid
  workspaceId               String                     @map("workspace_id") @db.Uuid
  name                      String
  handle                    String?
  description               String?
  niche                     String?
  language                  String?
  audience                  String?
  timezone                  String                     @default("UTC")
  goals                     Json?
  schedule                  Json?
  automationDefaults        Json?                      @map("automation_defaults")
  approvalPolicy            Json?                      @map("approval_policy")
  publishingDestinations    Json?                      @map("publishing_destinations")
  status                    ChannelStatus              @default(ACTIVE)
  activeSnapshotId          String?                    @map("active_snapshot_id") @db.Uuid
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace                 Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  series                    ContentSeries[]
  videos                    Video[]
  posts                     Post[]
  characterGroupAssignments CharacterGroupAssignment[]
  ideas                     Idea[]
  ideaApprovalSnapshots     IdeaApprovalSnapshot[]
  sceneMediaJobs            SceneMediaJob[]
  snapshots                 ChannelConfigSnapshot[]
  socialAccounts            SocialAccount[]
  socialOAuthStates         SocialOAuthState[]
  scheduledPosts            ScheduledPost[]
  metricCollectionJobs      MetricCollectionJob[]
  metricSnapshots           AnalyticsMetricSnapshot[]
  performanceInsightReports PerformanceInsightReport[]
  performanceRecommendations PerformanceRecommendation[]
  performanceExperiments    PerformanceExperiment[]
  performanceStrategyChanges PerformanceStrategyChange[]
  activeSnapshot            ChannelConfigSnapshot?     @relation("ChannelActiveSnapshot", fields: [workspaceId, activeSnapshotId], references: [workspaceId, id])

  @@unique([workspaceId, id])
  @@unique([workspaceId, activeSnapshotId])
  @@index([workspaceId])
  @@map("channels")
}

model ChannelConfigSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  channelId   String   @map("channel_id") @db.Uuid
  version     Int
  config      Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  channel     Channel  @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)
  activeFor   Channel? @relation("ChannelActiveSnapshot")

  @@unique([workspaceId, id])
  @@unique([workspaceId, channelId, version])
  @@index([workspaceId, channelId, createdAt])
  @@map("channel_config_snapshots")
}

model SocialAccount {
  id                String                    @id @default(uuid()) @db.Uuid
  workspaceId       String                    @map("workspace_id") @db.Uuid
  channelId         String                    @map("channel_id") @db.Uuid
  platform          SocialPlatform
  remoteAccountId   String                    @map("remote_account_id")
  displayName       String                    @map("display_name")
  username          String?
  status            SocialAccountStatus       @default(CONNECTED)
  health            SocialAccountHealth       @default(UNAVAILABLE)
  connectedAt       DateTime                  @default(now()) @map("connected_at") @db.Timestamptz(6)
  lastHealthCheckAt DateTime?                 @map("last_health_check_at") @db.Timestamptz(6)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace         Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel           Channel                   @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)
  tokens            SocialAccountToken?
  permissions       SocialAccountPermission[]
  capabilities      SocialAccountCapability[]
  publishingDestinations PublishingDestination[]
  metricCollectionJobs MetricCollectionJob[]
  metricSnapshots   AnalyticsMetricSnapshot[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, channelId, platform, remoteAccountId])
  @@index([workspaceId, channelId, platform, status])
  @@map("social_accounts")
}

model SocialAccountToken {
  id                     String        @id @default(uuid()) @db.Uuid
  workspaceId            String        @map("workspace_id") @db.Uuid
  socialAccountId        String        @unique @map("social_account_id") @db.Uuid
  accessTokenCiphertext  String        @map("access_token_ciphertext")
  accessTokenNonce       String        @map("access_token_nonce")
  accessTokenTag         String        @map("access_token_tag")
  refreshTokenCiphertext String?       @map("refresh_token_ciphertext")
  refreshTokenNonce      String?       @map("refresh_token_nonce")
  refreshTokenTag        String?       @map("refresh_token_tag")
  encryptionKeyVersion   String        @map("encryption_key_version")
  accessTokenExpiresAt   DateTime      @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt  DateTime?     @map("refresh_token_expires_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  socialAccount          SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, socialAccountId])
  @@index([workspaceId, accessTokenExpiresAt])
  @@map("social_account_tokens")
}

model SocialAccountPermission {
  id              String                 @id @default(uuid()) @db.Uuid
  workspaceId     String                 @map("workspace_id") @db.Uuid
  socialAccountId String                 @map("social_account_id") @db.Uuid
  permission      String
  status          SocialPermissionStatus
  recordedAt      DateTime               @default(now()) @map("recorded_at") @db.Timestamptz(6)
  socialAccount   SocialAccount          @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([socialAccountId, permission])
  @@index([workspaceId, socialAccountId])
  @@map("social_account_permissions")
}

model SocialAccountCapability {
  id              String        @id @default(uuid()) @db.Uuid
  workspaceId     String        @map("workspace_id") @db.Uuid
  socialAccountId String        @map("social_account_id") @db.Uuid
  capability      String
  enabled         Boolean
  details         Json?
  checkedAt       DateTime      @default(now()) @map("checked_at") @db.Timestamptz(6)
  socialAccount   SocialAccount @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([socialAccountId, capability])
  @@index([workspaceId, socialAccountId])
  @@map("social_account_capabilities")
}

model SocialOAuthState {
  id                      String         @id @default(uuid()) @db.Uuid
  workspaceId             String         @map("workspace_id") @db.Uuid
  channelId               String         @map("channel_id") @db.Uuid
  userId                  String         @map("user_id") @db.Uuid
  platform                SocialPlatform
  expectedRemoteAccountId String         @map("expected_remote_account_id")
  stateHash               String         @unique @map("state_hash")
  codeVerifierCiphertext  String         @map("code_verifier_ciphertext")
  codeVerifierNonce       String         @map("code_verifier_nonce")
  codeVerifierTag         String         @map("code_verifier_tag")
  expiresAt               DateTime       @map("expires_at") @db.Timestamptz(6)
  consumedAt              DateTime?      @map("consumed_at") @db.Timestamptz(6)
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace               Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel                 Channel        @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, expiresAt])
  @@index([expiresAt, consumedAt])
  @@map("social_oauth_states")
}

model ContentSeries {
  id                        String                     @id @default(uuid()) @db.Uuid
  workspaceId               String                     @map("workspace_id") @db.Uuid
  channelId                 String                     @map("channel_id") @db.Uuid
  name                      String
  genreId                   String                     @map("genre_id") @db.Uuid
  format                    String
  frequency                 String
  characterGroupRefs        Json                       @map("character_group_refs")
  promptRefs                Json                       @map("prompt_refs")
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  channel                   Channel                    @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)
  genre                     Genre                      @relation(fields: [workspaceId, genreId], references: [workspaceId, id], onDelete: Restrict)
  videos                    Video[]
  ideas                     Idea[]
  ideaApprovalSnapshots     IdeaApprovalSnapshot[]
  characterGroupAssignments CharacterGroupAssignment[]

  @@unique([workspaceId, id])
  @@index([workspaceId, channelId])
  @@index([workspaceId, genreId])
  @@map("content_series")
}

model GenreTemplate {
  id                 String   @id @default(uuid()) @db.Uuid
  key                String   @unique
  name               String
  audience           String
  tone               String
  topicsAllowed      Json     @map("topics_allowed")
  topicsBlocked      Json     @map("topics_blocked")
  language           String
  structure          Json
  durationPreference Json     @map("duration_preference")
  safetyProfile      Json     @map("safety_profile")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  genres             Genre[]

  @@map("genre_templates")
}

model Genre {
  id                 String          @id @default(uuid()) @db.Uuid
  workspaceId        String          @map("workspace_id") @db.Uuid
  templateId         String?         @map("template_id") @db.Uuid
  name               String
  audience           String
  tone               String
  topicsAllowed      Json            @map("topics_allowed")
  topicsBlocked      Json            @map("topics_blocked")
  language           String
  structure          Json
  durationPreference Json            @map("duration_preference")
  safetyProfile      Json            @map("safety_profile")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template           GenreTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  series             ContentSeries[]

  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
  @@map("genres")
}

model Asset {
  id                String                  @id @default(uuid()) @db.Uuid
  workspaceId       String                  @map("workspace_id") @db.Uuid
  objectKey         String                  @map("object_key")
  mediaType         String                  @map("media_type")
  filename          String?
  byteSize          Int?                    @map("byte_size")
  checksumSha256    String?                 @map("checksum_sha256")
  version           Int                     @default(1)
  rootAssetId       String                  @map("root_asset_id") @db.Uuid
  supersedesAssetId String?                 @map("supersedes_asset_id") @db.Uuid
  ownership         AssetOwnership          @default(USER_UPLOADED)
  status            AssetStatus             @default(PENDING)
  licenseType       String?                 @map("license_type")
  licenseTerms      String?                 @map("license_terms")
  rightsHolder      String?                 @map("rights_holder")
  rightsAttestedAt  DateTime?               @map("rights_attested_at") @db.Timestamptz(6)
  createdByUserId   String?                 @map("created_by_user_id") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace         Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supersedes        Asset?                  @relation("AssetVersionChain", fields: [workspaceId, supersedesAssetId], references: [workspaceId, id], onDelete: Restrict)
  versions          Asset[]                 @relation("AssetVersionChain")
  usageReferences   AssetUsageReference[]
  sceneOutputs      SceneGenerationOutput[]
  renderArtifacts   RenderArtifact[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, objectKey])
  @@unique([workspaceId, rootAssetId, version])
  @@index([workspaceId])
  @@index([workspaceId, rootAssetId])
  @@map("assets")
}

model Video {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  channelId   String         @map("channel_id") @db.Uuid
  seriesId    String?        @map("series_id") @db.Uuid
  // TODO(M10 composition): adopt the M10-owned video production status contract.
  status      String
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  channel     Channel        @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)
  series      ContentSeries? @relation(fields: [workspaceId, seriesId], references: [workspaceId, id], onDelete: Restrict)
  posts       Post[]

  @@unique([workspaceId, id])
  @@index([workspaceId, channelId, createdAt])
  @@map("videos")
}

model Post {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @map("workspace_id") @db.Uuid
  channelId    String        @map("channel_id") @db.Uuid
  videoId      String        @map("video_id") @db.Uuid
  platform     String
  status       PublishStatus
  remotePostId String?       @map("remote_post_id")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  channel      Channel       @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)
  video        Video         @relation(fields: [workspaceId, videoId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, channelId, createdAt])
  @@map("posts")
}

model WorkflowRun {
  id             String        @id @default(uuid()) @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  correlationId  String        @map("correlation_id") @db.Uuid
  idempotencyKey String        @map("idempotency_key")
  state          WorkflowState
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@unique([workspaceId, id])
  @@index([workspaceId, state, createdAt])
  @@map("workflow_runs")
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  eventType      String    @map("event_type")
  eventVersion   Int       @map("event_version")
  correlationId  String    @map("correlation_id") @db.Uuid
  channelId      String?   @map("channel_id") @db.Uuid
  causationId    String?   @map("causation_id") @db.Uuid
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key")
  payload        Json
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, publishedAt, occurredAt])
  @@map("outbox_events")
}

model ScheduledPost {
  id                         String                         @id @default(uuid()) @db.Uuid
  workspaceId                String                         @map("workspace_id") @db.Uuid
  channelId                  String                         @map("channel_id") @db.Uuid
  renderJobId                String                         @map("render_job_id") @db.Uuid
  qualityReviewRunId         String                         @map("quality_review_run_id") @db.Uuid
  revision                   Int                            @default(1)
  scheduledAt                DateTime?                      @map("scheduled_at") @db.Timestamptz(6)
  status                     PublishStatus                  @default(DRAFT)
  disclosureDecision         PublishingDisclosureDecision   @map("disclosure_decision")
  disclosureText             String?                        @map("disclosure_text")
  disclosureReason           String                         @map("disclosure_reason")
  manuallyAuthorizedAt       DateTime?                      @map("manually_authorized_at") @db.Timestamptz(6)
  manuallyAuthorizedByUserId String?                        @map("manually_authorized_by_user_id") @db.Uuid
  createdByUserId            String                         @map("created_by_user_id") @db.Uuid
  createdAt                  DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
