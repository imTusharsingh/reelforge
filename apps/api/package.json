{
  "name": "@reelforge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "pnpm --filter @reelforge/database db:generate && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@reelforge/ai-providers": "workspace:*",
    "@reelforge/config-engine": "workspace:*",
    "@reelforge/contracts": "workspace:*",
    "@reelforge/database": "workspace:*",
    "@reelforge/media": "workspace:*",
    "@reelforge/social-providers": "workspace:*",
    "bullmq": "6.6.0",
    "express": "5.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.3",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4"
  },
  "exports": {
    "./asset-service": {
      "types": "./dist/modules/asset/asset.service.d.ts",
      "import": "./dist/modules/asset/asset.service.js"
    },
    "./composition-service": {
      "types": "./dist/modules/composition/composition.service.d.ts",
      "import": "./dist/modules/composition/composition.service.js"
    },
    "./composition-engine": {
      "types": "./dist/modules/composition/composition.engine.d.ts",
      "import": "./dist/modules/composition/composition.engine.js"
    },
    "./social-accounts-service": {
      "types": "./dist/modules/social-accounts/social-accounts.service.d.ts",
      "import": "./dist/modules/social-accounts/social-accounts.service.js"
    },
    "./publishing-service": {
      "types": "./dist/modules/publishing/publishing.service.d.ts",
      "import": "./dist/modules/publishing/publishing.service.js"
    },
    "./storage-factory": {
      "types": "./dist/modules/asset/storage/storage.factory.d.ts",
      "import": "./dist/modules/asset/storage/storage.factory.js"
    },
    "./app-module": {
      "types": "./dist/app-module.d.ts",
      "import": "./dist/app-module.js"
    },
    "./orchestration-service": {
      "types": "./dist/orchestration-service.d.ts",
      "import": "./dist/orchestration-service.js"
    },
    "./orchestration-queue": {
      "types": "./dist/orchestration-queue.d.ts",
      "import": "./dist/orchestration-queue.js"
    },
    "./notifications-service": {
      "types": "./dist/notifications-service.d.ts",
      "import": "./dist/notifications-service.js"
    }
  }
}
