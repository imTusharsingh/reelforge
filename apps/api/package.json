{
  "name": "@reelforge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "pnpm --filter @reelforge/database db:generate && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@reelforge/ai-providers": "workspace:*",
    "@reelforge/config-engine": "workspace:*",
    "@reelforge/database": "workspace:*",
    "@reelforge/media": "workspace:*",
    "express": "5.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.3",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4"
  },
  "exports": {
    "./asset-service": {
      "types": "./types/asset.service.ts",
      "import": "./dist/modules/asset/asset.service.js"
    },
    "./composition-service": {
      "types": "./types/composition.service.ts",
      "import": "./dist/modules/composition/composition.service.js"
    },
    "./composition-engine": {
      "types": "./types/composition.engine.ts",
      "import": "./dist/modules/composition/composition.engine.js"
    },
    "./storage-factory": {
      "types": "./types/storage.factory.ts",
      "import": "./dist/modules/asset/storage/storage.factory.js"
    }
  }
}
